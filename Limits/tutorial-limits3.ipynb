   "source": [
    "import sympy as sp\n",
    "\n",
    "x = sp.symbols('x')\n",
    "# Define a piecewise function\n",
    "f = sp.Piecewise((x, x != 2), (3, x == 2))\n",
    "\n",
    "# Compute limit as x approaches 1 from both sides\n",
    "\n",
    "lim_val = sp.limit(f, x, 2)\n",
    "lim_val"
   ]
  }
